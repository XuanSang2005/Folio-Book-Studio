# Local Fastify runtime
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
LOG_LEVEL=info

# Private SQLite and local source/artifact storage
DATABASE_PATH=./data/folio.sqlite
DATA_DIR=./data

# Gemini is backend-only and optional. Never commit a real key. Leaving this
# blank keeps the app bootable; generation returns GEMINI_NOT_CONFIGURED.
# The quality-focused image default does not automatically fall back. The
# notebook's Lite model may be selected only through an explicit override.
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.6-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_REQUEST_TIMEOUT_MS=120000

# Pipeline lease: HEARTBEAT_MS must be less than half of STEP_LEASE_MS.
STEP_LEASE_MS=180000
HEARTBEAT_MS=30000

# Session and payload boundaries
SESSION_TTL_SECONDS=604800
MAX_SOURCE_BYTES=5242880
MAX_IMAGE_BYTES=15728640
COOKIE_NAME=folio_session
